{
  "schema_version": 1,
  "profile_id": "openfde",
  "display_name": "OpenFDE",
  "github": {
    "repository": "openfde/openfde"
  },
  "manifest": {
    "adapter": "android-repo-xml",
    "path": "fde-manifests/default.xml",
    "override_rule": "apply include, remove-project, and project elements in source order"
  },
  "sources": {
    "mode": "local_tree",
    "path": "fde-sources",
    "build_path": "fde-build",
    "read_only": true
  },
  "build": {
    "enabled": true,
    "install": true,
    "mode": "assist",
    "helper": "deploy/server/fde-ai-build.sh",
    "command": "deploy/assist/build-install.sh",
    "module_map": "deploy/assist/modules.json",
    "host": "10.31.62.29",
    "tree": "/aosp4/hy_fde17",
    "sources_tree": "fde-sources",
    "lock": "data/build.lock",
    "target": "fde_arm64-cp2a-user",
    "product": "fde_arm64",
    "output": "out",
    "modules": ["DocumentsUI"],
    "artifacts": [
      "target/product/fde_arm64/system/priv-app/DocumentsUI/DocumentsUI.apk"
    ],
    "max_jobs": 4,
    "install_host": "10.31.62.247",
    "installer": "/usr/local/sbin/fde-install-module",
    "ssh_key": "/workspace/data/ssh/id_ed25519",
    "known_hosts": "/workspace/data/ssh/known_hosts"
  },
  "intake": {
    "root": "data/intake",
    "size_budget_mb": 24,
    "default_channel": "server_adb",
    "allow_root": false
  },
  "components": {
    "map_seed": "profiles/openfde/component-map",
    "map_learned": "data/knowledge/component-map",
    "review_state": "component_review_requested"
  },
  "artifacts": {
    "run_root": ".fde-ai/issues",
    "source_cache": ".fde-ai/sources",
    "knowledge_root": "data/knowledge",
    "case_root": "data/knowledge/cases",
    "issue_layout": {
      "root": ".fde-ai/issues/{issue_number}",
      "state": "state.json",
      "required_directories": ["input", "evidence", "analysis", "solution", "patch", "build", "comment", "archive"],
      "patch": "patch/0001-{slug}.patch"
    }
  },
  "publication": {
    "mode": "manual_per_issue",
    "allow_auto_information_requests": true,
    "interaction_comments": "pr_only",
    "analysis_options_comment": "auto",
    "reproduction_plan_comment": "auto",
    "debug_pr_comment": "auto",
    "dry_run": true,
    "minimum_confidence": "high",
    "blocked_labels": ["no-ai-reply"]
  },
  "triage": {
    "analysis_reply_min_confidence": 50,
    "auto_pr_min_confidence": 70,
    "max_deep_analysis_rounds": 2
  },
  "replies": {
    "poll_seconds": 300
  },
  "pull_request": {
    "enabled": true,
    "provider": "github",
    "base_branch": "fde_17"
  },
  "debug_pull_request": {
    "enabled": true,
    "provider": "github",
    "base_branch": "fde_17",
    "branch_prefix": "ai-debug/",
    "instrumentation_only": true,
    "merge": false
  }
}
