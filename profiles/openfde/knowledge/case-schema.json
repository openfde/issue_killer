{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openfde.local/schemas/knowledge-case.json",
  "title": "OpenFDE issue knowledge case",
  "type": "object",
  "required": [
    "schema_version",
    "case_id",
    "issue",
    "repo",
    "title",
    "status",
    "revision",
    "knowledge_status",
    "provenance",
    "updated_at"
  ],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "case_id": { "type": "string", "pattern": "^issue-[0-9]+$" },
    "issue": { "type": "integer", "minimum": 1 },
    "repo": { "type": "string" },
    "title": { "type": "string" },
    "url": { "type": ["string", "null"] },
    "status": { "type": "string" },
    "revision": { "type": "integer", "minimum": 1 },
    "created_at": { "type": ["string", "null"] },
    "updated_at": { "type": "string" },
    "device": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "model": { "type": ["string", "null"] },
        "build": { "type": ["string", "null"] },
        "android": { "type": ["string", "null"] }
      }
    },
    "components": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "project": { "type": ["string", "null"] },
          "local_path": { "type": ["string", "null"] },
          "confidence": { "type": ["string", "null"] },
          "source": { "type": ["string", "null"] }
        }
      }
    },
    "signals": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "kind": { "type": ["string", "null"] },
          "value": { "type": ["string", "null"] }
        }
      }
    },
    "symptom": { "type": "string" },
    "root_cause": { "type": "string" },
    "fix": {
      "type": "object",
      "additionalProperties": true
    },
    "verification": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "status": { "type": ["string", "null"] },
        "verified": { "type": "boolean" },
        "verified_by": { "type": ["string", "null"] },
        "verified_at": { "type": ["string", "null"] },
        "evidence": { "type": "array", "items": { "type": "string" } }
      }
    },
    "knowledge_status": {
      "type": "string",
      "enum": ["draft", "verified", "rejected"]
    },
    "confidence": { "type": ["number", "string", "null"] },
    "tags": { "type": "array", "items": { "type": "string" } },
    "provenance": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "issue_dir": { "type": ["string", "null"] },
        "state": { "type": ["string", "null"] },
        "archive_case": { "type": ["string", "null"] },
        "components": { "type": ["string", "null"] },
        "issue_snapshot": { "type": ["string", "null"] },
        "hashes": { "type": "object", "additionalProperties": { "type": "string" } }
      }
    }
  },
  "additionalProperties": true
}
