# 复制为项目根目录 .env（或直接 export 同名变量）。不得提交真实值。
# GitHub token：经典 PAT 勾选 repo + read:org，或 fine-grained：
# Issues/Contents/Pull requests = Read and write，Metadata = Read。
# 创建：https://github.com/settings/tokens
GH_TOKEN=

# 模型：默认 deepseek/deepseek-flash；可切换其他 provider/model。
PI_PROVIDER=deepseek
PI_MODEL=deepseek-flash
DEEPSEEK_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# GOOGLE_API_KEY=
# 可选：OpenAI 兼容网关地址
# PI_BASE_URL=

# 可选：首次源码同步（默认 GitHub 镜像，48 个仓库，分支 fde_17）
# FDE_SYNC_MODE=github
# FDE_SOURCE_BRANCH=fde_17
# FDE_SOURCE_MODULES=art build device external frameworks hardware openfde-sdk packages prebuilts system
# FDE_MANIFEST_URL=https://github.com/openfde/fde-manifests.git
# FDE_MANIFEST_BRANCH=fde_17
# FDE_SYNC_JOBS=8
# 若内部 GitLab 可达，可使用 Android repo 模式：
# FDE_SYNC_MODE=repo
# FDE_MANIFEST_URL=https://src.ift.run/openfde17/fde-manifests

# Docker 镜像构建源（国内网络）
# NPM_REGISTRY=https://registry.npmmirror.com
# REPO_URL=https://mirrors.tuna.tsinghua.edu.cn/git/git-repo/repo

# 定时扫描间隔（秒），供 deploy/run-scan-loop.sh 使用。
SCAN_INTERVAL_SECONDS=1800
